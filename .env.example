PORT=3000
ADMIN_PASSWORD=

# Chat provider. Include /v1 when the provider requires it.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Blank URL/key uses the chat provider. For a separate URL, set its key too.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Optional. Set only if the embedding provider supports the dimensions option.
EMBEDDING_DIMENSIONS=

# Use a dense, serverless cosine index matching your embedding dimensions.
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=prigel
PINECONE_MIN_SCORE=0.25
